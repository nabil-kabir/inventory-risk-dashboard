                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Marked down units sell at list price less the markdown. The clearance response sets how much stock at risk each 10 points of markdown clears within 90 days.",
                    "textStyle": {
                      "fontSize": "10.5pt",
                      "color": "#ECE7DF",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Whatever is left is cleared later at the historical recovery rate. The suggested markdown is the step that recovers the most for each SKU.",
                    "textStyle": {
                      "fontSize": "10.5pt",
                      "color": "#ECE7DF",
                      "fontFamily": "Segoe UI"
                    }
