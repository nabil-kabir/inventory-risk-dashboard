              {
                "textRuns": [
                  {
                    "value": "The question",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#F2B35B",
                      "fontFamily": "Segoe UI Semibold",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Which stock is about to become a loss, how much money is at risk, and what should we do this week?",
                    "textStyle": {
                      "fontSize": "10.5pt",
                      "color": "#ECE7DF",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "This dashboard recreates, on public data, the aging inventory analysis I ran as a BI leader in online retail, where acting early on old stock protected real money.",
                    "textStyle": {
                      "fontSize": "10.5pt",
                      "color": "#ECE7DF",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "6pt",
                      "color": "#ECE7DF",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The data",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#F2B35B",
                      "fontFamily": "Segoe UI Semibold",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Demand is real: 104,884 order lines from the Olist Brazilian ecommerce dataset (public, on Kaggle), January 2017 to July 2018.",
                    "textStyle": {
                      "fontSize": "10.5pt",
                      "color": "#ECE7DF",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Inventory is simulated. Olist publishes no stock data, so purchases, batches and month end stock were rebuilt from the real sales by a documented, seeded Python script.",
                    "textStyle": {
                      "fontSize": "10.5pt",
                      "color": "#ECE7DF",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              }
            ]
