    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "How stock was simulated",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#F2B35B",
                      "fontFamily": "Segoe UI Semibold",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Each SKU (one product sold by one seller) gets purchase batches timed to meet its real sales.",
                    "textStyle": {
                      "fontSize": "10.5pt",
                      "color": "#ECE7DF",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Buyers reorder at a reorder point. Their forecasts carry a bias, and 15% of sellers habitually over order.",
                    "textStyle": {
                      "fontSize": "10.5pt",
                      "color": "#ECE7DF",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Sales use stock first in, first out. Batches still unsold after 270 days are cleared for 10% to 40% of cost.",
                    "textStyle": {
                      "fontSize": "10.5pt",
                      "color": "#ECE7DF",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "6pt",
                      "color": "#ECE7DF",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "How value at risk is measured",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#F2B35B",
                      "fontFamily": "Segoe UI Semibold",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Each SKU's last 90 days of sales set its pace. Units sell first in, first out at that pace.",
                    "textStyle": {
                      "fontSize": "10.5pt",
                      "color": "#ECE7DF",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "A unit is at risk if it would be older than 180 days by the time it sells. A SKU with no sales in 90 days has all of its stock at risk.",
                    "textStyle": {
                      "fontSize": "10.5pt",
                      "color": "#ECE7DF",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
