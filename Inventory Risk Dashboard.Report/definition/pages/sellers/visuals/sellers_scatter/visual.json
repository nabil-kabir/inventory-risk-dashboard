{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.12.0/schema.json",
  "name": "sellers_scatter",
  "position": {
    "x": 420,
    "y": 188,
    "z": 8000,
    "height": 230,
    "width": 836,
    "tabOrder": 8000
  },
  "visual": {
    "visualType": "scatterChart",
    "drillFilterOtherVisuals": true,
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Seller"
                    }
                  },
                  "Property": "Seller"
                }
              },
              "queryRef": "Seller.Seller",
              "nativeQueryRef": "Seller"
            }
          ]
        },
        "X": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Metrics"
                    }
                  },
                  "Property": "Stock Value"
                }
              },
              "queryRef": "Metrics.Stock Value",
              "nativeQueryRef": "Stock on hand",
              "displayName": "Stock on hand"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Metrics"
                    }
                  },
                  "Property": "Value at Risk %"
                }
              },
              "queryRef": "Metrics.Value at Risk %",
              "nativeQueryRef": "Share at risk",
              "displayName": "Share at risk"
            }
          ]
        },
        "Size": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Metrics"
                    }
                  },
                  "Property": "Value at Risk"
                }
              },
              "queryRef": "Metrics.Value at Risk",
              "nativeQueryRef": "Value at risk",
              "displayName": "Value at risk"
            }
          ]
        }
      }
    },
    "objects": {
      "dataPoint": [
        {
          "properties": {
            "fill": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#2F8FB5'"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Each seller: stock held against share at risk (bubble size: value at risk)'"
                }
              }
            }
          }
        }
      ]
    }
  }
}
