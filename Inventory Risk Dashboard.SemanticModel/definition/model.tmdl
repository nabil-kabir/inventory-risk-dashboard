model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DevMode","MCP-PBIModeling"]

ref table Date
ref table 'Aging Bucket'
ref table Product
ref table Seller
ref table SKU
ref table Sales
ref table Receipts
ref table 'Stock Snapshot'
ref table 'Write Offs'
ref table Metrics
ref table Markdown
ref table 'Clearance Response'

ref cultureInfo en-US

